# ==========================================
# OLD AGE HOME MANAGEMENT SYSTEM - ENV CONFIG
# ==========================================

# 1. MongoDB Connection String (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/old_age_home?retryWrites=true&w=majority

# 2. NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
# Generate secret using: openssl rand -base64 32
NEXTAUTH_SECRET=change_this_to_a_secure_random_32_byte_secret_key_123

# 3. Google OAuth 2.0 Credentials
# Get from Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (and your production vercel domain)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 4. Super Admin Initial Setup
# Anyone signing in with Google matching this email automatically becomes Super Admin.
# All other Google signups enter 'pending' status until manually approved by Super Admin.
SUPER_ADMIN_EMAIL=admin@ananddham.org
SUPER_ADMIN_PASSWORD=AdminSecurePass123!
SUPER_ADMIN_NAME=Senior Admin

# 5. Data Encryption Key (AES-256-GCM)
# 32 characters or 64 hex characters for encrypting sensitive fields at rest (e.g. Aadhaar / Govt ID)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 6. Optional Cloudinary URL for media/documents upload
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 7. Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWKS_URL=https://<your-project-id>.supabase.co/auth/v1/.well-known/jwks.json
